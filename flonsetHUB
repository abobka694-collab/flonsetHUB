-- Функция для быстрого создания вкладок
local function CreateTab(tabName)
    -- Создаем контейнер для функций этой вкладки
    local TabContainer = Instance.new("Frame")
    TabContainer.Size = UDim2.new(1, 0, 1, 0)
    TabContainer.BackgroundTransparency = 1
    TabContainer.Visible = false
    TabContainer.Parent = ContentPanel
    
    -- Заголовок внутри вкладки
    local TabTitle = Instance.new("TextLabel")
    TabTitle.Size = UDim2.new(1, 0, 0, 25)
    TabTitle.Text = tabName
    TabTitle.TextColor3 = Color3.fromRGB(150, 150, 170)
    TabTitle.Font = Enum.Font.GothamBold
    TabTitle.TextSize = 11
    TabTitle.TextXAlignment = Enum.TextXAlignment.Left
    TabTitle.BackgroundTransparency = 1
    TabTitle.Parent = TabContainer
    
    tabs[tabName] = TabContainer
    
    -- Создаем кнопку переключения на эту вкладку в SideBar
    local btnCount = #tabButtons
    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(0.9, 0, 0, 26)
    TabBtn.Position = UDim2.new(0.05, 0, 0, 40 + (btnCount * 30))
    TabBtn.Text = tabName
    TabBtn.Font = Enum.Font.GothamBold
    TabBtn.TextSize = 10
    TabBtn.TextColor3 = Color3.fromRGB(160, 160, 180)
    TabBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 50)
    TabBtn.Parent = SideBar
    
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = TabBtn
    
    table.insert(tabButtons, TabBtn)
    
    -- Логика переключения вкладок при клике
    TabBtn.MouseButton1Click:Connect(function()
        -- Скрываем все вкладки и сбрасываем цвета кнопок
        for name, container do
            container.Visible = false
        end
        for _, btn in ipairs(tabButtons) do
            btn.BackgroundColor3 = Color3.fromRGB(38, 38, 50)
            btn.TextColor3 = Color3.fromRGB(160, 160, 180)
        end
        -- Активируем выбранную
        TabContainer.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 75) -- Подсвечиваем активную кнопку
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
end

