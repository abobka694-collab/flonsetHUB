print("[ARCEUS-FIX] Запуск неуязвимого интерфейса...")

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- 1. НАХОДИМ ПРАВИЛЬНУЮ ПАПКУ ДЛЯ СМАРТФОНОВ
-- Arceus часто блокирует CoreGui, поэтому принудительно пихаем меню в PlayerGui игрока
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Если старое меню уже было на экране, удаляем его, чтобы не было дубликатов
if PlayerGui:FindFirstChild("FlonsetMobileGui") then
    PlayerGui.FlonsetMobileGui:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FlonsetMobileGui"
ScreenGui.ResetOnSpawn = false -- Меню не пропадет, когда тебя убьют
ScreenGui.Parent = PlayerGui

-- Главное окошко чита (компактное, под экран телефона)
local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 180, 0, 150)
Frame.Position = UDim2.new(0.1, 0, 0.25, 0) -- Появится чуть левее центра экрана
Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true -- Можно перетаскивать пальцем по экрану!
Frame.Parent = ScreenGui

-- Скругление углов (чтобы меню было красивым)
local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 8)
Corner.Parent = Frame

-- Шапка/Заголовок меню
local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "  FLONSET MM2 HUB"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextXAlignment = Enum.TextXAlignment.Left
Title.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 12
Title.Parent = Frame

local TitleCorner = Instance.new("UICorner")
TitleCorner.CornerRadius = UDim.new(0, 8)
TitleCorner.Parent = Title

-- 2. ФУНКЦИЯ 1: КНОПКА СКОРОСТИ БЕГА (WalkSpeed)
local SpeedButton = Instance.new("TextButton")
SpeedButton.Size = UDim2.new(0.9, 0, 0, 32)
SpeedButton.Position = UDim2.new(0.05, 0, 0, 42)
SpeedButton.Text = "WalkSpeed: OFF"
SpeedButton.Font = Enum.Font.GothamBold
SpeedButton.TextSize = 11
SpeedButton.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
SpeedButton.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedButton.Parent = Frame

local SpeedCorner = Instance.new("UICorner")
SpeedCorner.CornerRadius = UDim.new(0, 6)
SpeedCorner.Parent = SpeedButton

local speedEnabled = false
SpeedButton.MouseButton1Click:Connect(function()
    speedEnabled = not speedEnabled
    if speedEnabled then
        SpeedButton.Text = "WalkSpeed: ON (32)"
        SpeedButton.BackgroundColor3 = Color3.fromRGB(0, 160, 100) -- Зеленый
    else
        SpeedButton.Text = "WalkSpeed: OFF"
        SpeedButton.BackgroundColor3 = Color3.fromRGB(50, 50, 65) -- Обычный
    end
end)

-- Безопасный мобильный цикл удержания скорости
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = speedEnabled and 32 or 16
            end
        end)
    end
end)

-- 3. ФУНКЦИЯ 2: КНОПКА БЕЗОПАСНОЙ ПОДСВЕТКИ (Box ESP)
local EspButton = Instance.new("TextButton")
EspButton.Size = UDim2.new(0.9, 0, 0, 32)
EspButton.Position = UDim2.new(0.05, 0, 0, 82)
EspButton.Text = "Role ESP: OFF"
EspButton.Font = Enum.Font.GothamBold
EspButton.TextSize = 11
EspButton.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
EspButton.TextColor3 = Color3.fromRGB(255, 255, 255)
EspButton.Parent = Frame

local EspCorner = Instance.new("UICorner")
EspCorner.CornerRadius = UDim.new(0, 6)
EspCorner.Parent = EspButton

local espEnabled = false
local currentBoxes = {}

local function applyMobileESP(player)
    if player == LocalPlayer then return end
    
    local function onCharAdded(char)
        task.wait(0.5)
        if not espEnabled then return end
        
        -- Используем легкие SelectionBox, которые Arceus X гарантированно рендерит
        local box = Instance.new("SelectionBox")
        box.Name = "MobileESPBox"
        box.LineThickness = 0.04
        box.Adornee = char
        box.Parent = ScreenGui -- Привязываем к нашему GUI
        currentBoxes[player] = box
        
        task.spawn(function()
            while char and char.Parent and espEnabled do
                local knife = char:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife")
                local gun = char:FindFirstChild("Gun") or player.Backpack:FindFirstChild("Gun")
                
                if knife then
                    box.Color3 = Color3.fromRGB(255, 50, 50) -- Убийца (Красный)
                elseif gun then
                    box.Color3 = Color3.fromRGB(50, 150, 255) -- Шериф (Синий)
                else
                    box.Color3 = Color3.fromRGB(50, 255, 100) -- Невинный (Зеленый)
                end
                task.wait(1)
            end
            if box then box:Destroy() end
        end)
    end
    
    if player.Character then task.spawn(onCharAdded, player.Character) end
    player.CharacterAdded:Connect(onCharAdded)
end

EspButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    if espEnabled then
        EspButton.Text = "Role ESP: ON"
        EspButton.BackgroundColor3 = Color3.fromRGB(0, 160, 100)
        for _, p in ipairs(Players:GetPlayers()) do applyMobileESP(p) end
    else
        EspButton.Text = "Role ESP: OFF"
        EspButton.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
        for _, b in pairs(currentBoxes) do pcall(function() b:Destroy() end) end
        table.clear(currentBoxes)
    end
end)

Players.PlayerAdded:Connect(function(p)
    if espEnabled then applyMobileESP(p) end
end)

