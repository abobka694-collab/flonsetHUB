-- =======================================================
-- ORION HUB ДЛЯ MM2 (СПЕЦИАЛЬНО ПОД ARCEUS X NEO)
-- =======================================================
print("[ARCEUS-X] Инициализация безопасного меню...")

-- Загружаем чистую и стабильную Orion Library
local OrionLib = loadstring(game:HttpGet(('https://githubusercontent.com')))()

-- Создаем окно хаба (Тема адаптирована под телефон)
local Window = OrionLib:MakeWindow({Name = "FLONSET HUB (MM2)", HidePremium = true, SaveConfig = false, ConfigFolder = "OrionTest"})

-- Переменные для функций
local speedEnabled = false
local speedValue = 32
local espEnabled = false
local espBoxes = {}

-- =======================================================
-- ВКЛАДКА 1: PLAYER (Скорость бега)
-- =======================================================
local Tab1 = Window:MakeTab({Name = "Player", Icon = "rbxassetid://4483345998", PremiumOnly = false})

Tab1:AddSlider({
	Name = "Speed Power",
	Min = 16,
	Max = 100,
	Default = 32,
	Color = Color3.fromRGB(255,255,255),
	Increment = 1,
	ValueName = "studs",
	Callback = function(Value)
		speedValue = value
	end    
})

Tab1:AddToggle({
	Name = "Enable Speed",
	Default = false,
	Callback = function(Value)
		speedEnabled = Value
	end
})

-- Безопасный фоновый цикл скорости
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            local char = game.Players.LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = speedEnabled and speedValue or 16
            end
        end)
    end
end)

-- =======================================================
-- ВКЛАДКА 2: VISUALS (Безопасный Box ESP для мобилок)
-- =======================================================
local Tab2 = Window:MakeTab({Name = "Visuals", Icon = "rbxassetid://4483345998", PremiumOnly = false})

local function applyMobileESP(player)
    if player == game.Players.LocalPlayer then return end
    
    local function onChar(char)
        task.wait(0.5)
        if not espEnabled then return end
        
        -- Используем не лагающий на телефонах Box (SelectionBox вместо Highlight)
        local box = Instance.new("SelectionBox")
        box.Name = "ArceusESP"
        box.LineThickness = 0.05
        box.Adornee = char
        box.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
        espBoxes[player] = box
        
        task.spawn(function()
            while char and char.Parent and espEnabled do
                local knife = char:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife")
                local gun = char:FindFirstChild("Gun") or player.Backpack:FindFirstChild("Gun")
                
                if knife then
                    box.Color3 = Color3.fromRGB(255, 0, 0) -- Красный Убийца
                elseif gun then
                    box.Color3 = Color3.fromRGB(0, 150, 255) -- Синий Шериф
                else
                    box.Color3 = Color3.fromRGB(0, 255, 100) -- Невинный
                end
                task.wait(1)
            end
            if box then box:Destroy() end
        end)
    end
    
    if player.Character then task.spawn(onChar, player.Character) end
    player.CharacterAdded:Connect(onChar)
end

Tab2:AddToggle({
	Name = "Player Box ESP",
	Default = false,
	Callback = function(Value)
		espEnabled = Value
        if Value then
            for _, p in ipairs(game.Players:GetPlayers()) do applyMobileESP(p) end
        else
            for _, b in pairs(espBoxes) do pcall(function() b:Destroy() end) end
            table.clear(espBoxes)
        end
	end
})

game.Players.PlayerAdded:Connect(function(p)
    if espEnabled then applyMobileESP(p) end
end)

-- Финальный аккорд инициализации библиотеки Orion
OrionLib:Init()
