-- ТОПОВЫЕ МОБИЛЬНЫЕ ЧАМСЫ (CHAMS ESP) СКВОЗЬ СТЕНЫ
-- =======================================================
print("[FLONSET-CHAMS] Активация неонового ВХ...")

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Таблица для сохранения оригинальных материалов и цветов игроков
local originalMaterials = {}
local originalColors = {}
local activeChams = {}

-- Функция, которая превращает игрока в светящийся чамс
local function applyChams(player)
    if player == LocalPlayer then return end
    
    local function onCharAdded(char)
        task.wait(0.5) -- Даем модельке персонажа прогрузиться
        
        -- Постоянно удерживаем эффект, даже если игрок меняет оружие или одежду
        activeChams[player] = task.spawn(function()
            while char and char.Parent do
                -- Определяем роль игрока в реальном времени
                local knife = char:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife")
                local gun = char:FindFirstChild("Gun") or player.Backpack:FindFirstChild("Gun")
                
                -- Выбираем цвет в зависимости от роли
                local targetColor = Color3.fromRGB(0, 255, 100) -- Невинный (Зеленый)
                if knife then
                    targetColor = Color3.fromRGB(255, 0, 0) -- Убийца (Ярко-красный)
                elseif gun then
                    targetColor = Color3.fromRGB(0, 150, 255) -- Шериф (Синий)
                end
                
                -- Красим каждую часть тела в светящийся ForceField
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        -- Запоминаем оригинал, если красим впервые
                        if not originalMaterials[part] then
                            originalMaterials[part] = part.Material
                            originalColors[part] = part.Color
                        end
                        
                        -- Хакерский трюк: ForceField + Неоновый цвет = Сияние сквозь стены
                        if part.Material ~= Enum.Material.ForceField then
                            part.Material = Enum.Material.ForceField
                        end
                        if part.Color ~= targetColor then
                            part.Color = targetColor
                        end
                    end
                end
                task.wait(1) -- Проверяем роли раз в секунду, чтобы не лагало
            end
        end)
    end
    
    if player.Character then task.spawn(onCharAdded, player.Character) end
    player.CharacterAdded:Connect(onCharAdded)
end

-- Включаем чамсы для всех на сервере
for _, p in ipairs(Players:GetPlayers()) do
    applyChams(p)
end

-- Включаем чамсы для новых заходящих игроков
Players.PlayerAdded:Connect(applyChams)

-- Функция для полного отключения (если захочешь вернуть как было)
getgenv().DisableChams = function()
    -- Останавливаем циклы проверки
    for _, thread in pairs(activeChams) do
        pcall(function() task.cancel(thread) end)
    end
    table.clear(activeChams)
    
    -- Возвращаем игрокам их оригинальный вид
    for part, mat in pairs(originalMaterials) do
        if part and part.Parent then
            part.Material = mat
            part.Color = originalColors[part] or part.Color
        end
    end
    table.clear(originalMaterials)
    table.clear(originalColors)
    print("[FLONSET-CHAMS] ВХ отключено, текстуры восстановлены.")
end

print("[FLONSET-CHAMS] Сильнейшее неоновое ВХ успешно запущено!")
