-- =======================================================
-- НЕУЯЗВИМЫЙ МОБИЛЬНЫЙ ХАБ С КРУГЛЫМИ КНОПКАМИ (ДЛЯ ARCEUS X)
-- =======================================================
print("[FLONSET-FLOATING] Запуск кнопочного интерфейса...")

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

-- Безопасный подбор папки для кнопок
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FlonsetFloatingGui"
ScreenGui.ResetOnSpawn = false

local success, err = pcall(function()
    ScreenGui.Parent = CoreGui
end)
if not success then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

-- Переменные функций
local speedEnabled = false
local espEnabled = false
local grabEnabled = false

local originalMaterials = {}
local originalColors = {}
local activeChams = {}

-- Функция для быстрого создания круглых кнопок
local function CreateButton(text, pos, activeColor, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 50, 0, 50)
    Btn.Position = pos
    Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Text = text
    Btn.Font = Enum.Font.GothamBold
    Btn.TextSize = 10
    Btn.Active = true
    Btn.Draggable = true -- Любую кнопку можно перетащить пальцем куда угодно!
    Btn.Parent = ScreenGui
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(1, 0) -- Делает кнопку идеально круглой
    Corner.Parent = Btn
    
    local enabled = false
    Btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        if enabled then
            Btn.BackgroundColor3 = activeColor
        else
            Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        end
        callback(enabled)
    end)
    return Btn
end

-- =======================================================
-- СОЗДАЕМ КНОПКИ НА ЭКРАНЕ (Разнесены в левую часть экрана)
-- =======================================================

-- 1. Кнопка СКОРОСТИ (WalkSpeed)
CreateButton("SPEED", UDim2.new(0.02, 0, 0.2, 0), Color3.fromRGB(0, 160, 100), function(state)
    speedEnabled = state
end)

task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = speedEnabled and 32 or 16
            end
        end)
    end
end)

-- 2. Кнопка ВХ (Неоновые Чамсы сквозь стены)
local function applyMobileESP(player)
    if player == LocalPlayer then return end
    local function onCharAdded(char)
        task.wait(0.5)
        if not espEnabled then return end
        
        activeChams[player] = task.spawn(function()
            while char and char.Parent and espEnabled do
                local knife = char:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife")
                local gun = char:FindFirstChild("Gun") or player.Backpack:FindFirstChild("Gun")
                
                local targetColor = Color3.fromRGB(0, 255, 100) -- Зеленый (Мирный)
                if knife then
                    targetColor = Color3.fromRGB(255, 0, 0) -- Красный (Маньяк)
                elseif gun then
                    targetColor = Color3.fromRGB(0, 150, 255) -- Синий (Шериф)
                end
                
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        if not originalMaterials[part] then
                            originalMaterials[part] = part.Material
                            originalColors[part] = part.Color
                        end
                        if part.Material ~= Enum.Material.ForceField then
                            part.Material = Enum.Material.ForceField
                        end
                        if part.Color ~= targetColor then
                            part.Color = targetColor
                        end
                    end
                end
                task.wait(1)
            end
        end)
    end
    if player.Character then task.spawn(onCharAdded, player.Character) end
    player.CharacterAdded:Connect(onCharAdded)
end

CreateButton("CHAMS", UDim2.new(0.02, 0, 0.3, 0), Color3.fromRGB(0, 120, 255), function(state)
    espEnabled = state
    if state then
        for _, p in ipairs(Players:GetPlayers()) do applyMobileESP(p) end
    else
        for _, thread in pairs(activeChams) do pcall(function() task.cancel(thread) end) end
        table.clear(activeChams)
        for part, mat in pairs(originalMaterials) do
            if part and part.Parent then
                part.Material = mat
                part.Color = originalColors[part] or part.Color
            end
        end
        table.clear(originalMaterials)
        table.clear(originalColors)
    end
end)

Players.PlayerAdded:Connect(function(p)
    if espEnabled then applyMobileESP(p) end
end)

-- 3. Кнопка АВТОПОДБОРА ПИСТОЛЕТА (Auto-Grab)
CreateButton("GRAB", UDim2.new(0.02, 0, 0.4, 0), Color3.fromRGB(255, 160, 0), function(state)
    grabEnabled = state
end)

task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            if grabEnabled then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local gunDrop = workspace:FindFirstChild("GunDrop")
                
                if gunDrop and hrp then
                    local distance = (hrp.Position - gunDrop.Position).Magnitude
                    local duration = distance / 45
                    
                    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                    local tween = TweenService:Create(gunDrop, tweenInfo, {CFrame = hrp.CFrame})
                    tween:Play()
                end
            end
        end)
    end
end)

-- 4. Кнопка закрытия скрипта (Удаляет кнопки и сбрасывает эффекты)
local CloseBtn = CreateButton("EXIT", UDim2.new(0.02, 0, 0.5, 0), Color3.fromRGB(150, 0, 0), function(state)
    speedEnabled = false
    espEnabled = false
    grabEnabled = false
    for _, thread in pairs(activeChams) do pcall(function() task.cancel(thread) end) end
    for part, mat in pairs(originalMaterials) do
        if part and part.Parent then
            part.Material = mat
            part.Color = originalColors[part] or part.Color
        end
    end
    ScreenGui:Destroy()
end)
