-- 3. ФУНКЦИЯ 2: КНОПКА НАСТОЯЩЕГО ВХ НА РОЛИ (СКВОЗЬ СТЕНЫ)
-- =======================================================
local EspButton = Instance.new("TextButton")
EspButton.Size = UDim2.new(0.9, 0, 0, 32)
EspButton.Position = UDim2.new(0.05, 0, 0, 82)
EspButton.Text = "Role ESP: OFF"
EspButton.Font = Enum.Font.GothamBold
EspButton.TextSize = 11
EspButton.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
EspButton.TextColor3 = Color3.fromRGB(255, 255, 255)
EspButton.Parent = Frame

local EspCorner = Instance.new("UICorner")
EspCorner.CornerRadius = UDim.new(0, 6)
EspCorner.Parent = EspButton

local espEnabled = false
local originalNames = {}

local function applyMobileESP(player)
    if player == LocalPlayer then return end
    
    local function onCharAdded(char)
        task.wait(0.5)
        if not espEnabled then return end
        
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        
        -- Запоминаем родное имя игрока, если еще не сохранили
        if not originalNames[player] then
            originalNames[player] = player.DisplayName
        end
        local origName = originalNames[player]
        
        task.spawn(function()
            while char and char.Parent and espEnabled and hum.Parent do
                -- Принуждаем движок Роблокса показывать ник СКВОЗЬ ТЕКСТУРЫ КАРТЫ
                hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Always
                
                -- Логика проверки оружия в рюкзаке или руках
                local knife = char:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife")
                local gun = char:FindFirstChild("Gun") or player.Backpack:FindFirstChild("Gun")
                
                if knife then
                    hum.DisplayName = "== [MURDERER] == " .. origName
                elseif gun then
                    hum.DisplayName = "== [SHERIFF] == " .. origName
                else
                    hum.DisplayName = "[INNOCENT] " .. origName
                end
                task.wait(1)
            end
            
            -- Возвращаем стандартные настройки отображения ников при выключении
            if hum and hum.Parent then
                hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
                hum.DisplayName = origName
            end
        end)
    end
    
    if player.Character then task.spawn(onCharAdded, player.Character) end
    player.CharacterAdded:Connect(onCharAdded)
end

EspButton.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    if espEnabled then
        EspButton.Text = "Role ESP: ON"
        EspButton.BackgroundColor3 = Color3.fromRGB(0, 160, 100)
        for _, p in ipairs(Players:GetPlayers()) do applyMobileESP(p) end
    else
        EspButton.Text = "Role ESP: OFF"
        EspButton.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
        -- Сбрасываем никнеймы всех игроков к исходным
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChildOfClass("Humanoid") then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local origName = originalNames[p] or p.DisplayName
                hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
                hum.DisplayName = origName
            end
        end
    end
end)

Players.PlayerAdded:Connect(function(p)
    if espEnabled then applyMobileESP(p) end
end)

